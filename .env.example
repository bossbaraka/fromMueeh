# ============================================================
#  Mureeh — Talent & Service Provider Acquisition System
#  انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية.
#  ⚠️ لا تضع أي مفتاح داخل الكود أو داخل الـ Frontend.
# ============================================================

# --- Google Sheets (Server-side only) ---
# بريد حساب الخدمة (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="mureeh-sheets@your-project.iam.gserviceaccount.com"
# المفتاح الخاص (Private Key). حافظ على \n كما هي داخل الاقتباسات.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# معرّف ملف Google Sheet (من الرابط بين /d/ و /edit)
GOOGLE_SHEET_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"
# اسم الورقة (Tab) داخل الملف
GOOGLE_SHEET_TAB="Talent Applications"

# --- Anti-spam / Review ---
# مفتاح لحماية مسار تهيئة الأعمدة (يُنشئه الفريق)
ADMIN_BOOTSTRAP_TOKEN="change-me-long-random-string"
# مفتاح لعرض لوحة /team في الإنتاج (اتركه فارغًا في التطوير)
ADMIN_ACCESS_TOKEN=""
# Cloudflare Turnstile (اختياري — إن وُجد المفتاحان يتم التحقق server-side)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Behaviour ---
# عدد الطلبات المسموح بها لكل IP خلال النافذة الزمنية
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_MINUTES="15"
# عند عدم توفر مفاتيح Google Sheets: local = الحفظ في ملف NDJSON (وضع التطوير/العرض)
STORAGE_FALLBACK="local"
